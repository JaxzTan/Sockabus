# Copy to .env (git-ignored) and fill in. The Makefile exports these to `make run` / `make tglogin`.

# ─── Core ───
SOCKABUS_ENV=local
# demo = in-memory pitch data + scripted scammers (default). live = real Telegram honeypot on PostgreSQL.
SOCKABUS_MODE=live
SOCKABUS_HTTP_ADDR=:8080
# The app's database is Supabase (make run/dev/all, docker compose --profile app): see SOCKABUS_POSTGRES_URL below.
SOCKABUS_REDIS_ADDR=localhost:6379
SOCKABUS_TEMPORAL_HOSTPORT=localhost:7233
SOCKABUS_TEMPORAL_NAMESPACE=default
SOCKABUS_TEMPORAL_TASK_QUEUE=sockabus-main

# ─── Live mode secrets (make keys prints fresh values) ───
# Bearer token for /internal/* and /v1/lookup until operator login (email + TOTP) exists.
SOCKABUS_OPERATOR_TOKEN=
# operators.id recorded on operator actions (db/seed creates operator 1).
SOCKABUS_OPERATOR_ID=1
# Base64 32-byte key that encrypts message bodies at rest. Losing it makes stored messages unreadable.
SOCKABUS_MESSAGE_KEY=
# 1 (default): also write scammer identifiers in clear next to their ciphertext (migration 000012 phase 1).
# Set 0 only after cmd/backfill-encrypt -verify is clean, then apply db/migrations-pending/*_drop_plaintext_identifiers.
SOCKABUS_IDENTIFIER_PLAINTEXT=1

# ─── LLM ───
# anthropic (default, Claude) | gemini | fake (offline canned replies for CI/tests) | none (none = personas reply with playbook example lines only)
SOCKABUS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Persona replies and persona generation; extraction, classification and AI summaries.
SOCKABUS_PERSONA_MODEL=claude-sonnet-5-5
SOCKABUS_EXTRACT_MODEL=claude-haiku-5-5
# Only used when SOCKABUS_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Gemini only: thinking level for persona replies: low | medium | high
SOCKABUS_PERSONA_THINKING=low
# Max wait for one persona reply from the LLM before using the playbook's example line instead.
SOCKABUS_LLM_TIMEOUT=45s
# Per attempt: a chat-reply call that stalls longer than this is retried.
SOCKABUS_LLM_TRY_TIMEOUT=14s
# Per attempt for persona generation and AI summaries (2 attempts): long structured outputs.
SOCKABUS_PERSONA_GEN_TIMEOUT=90s
# Claude model for the anthropic persona client (internal/persona). Empty = claude-sonnet-5-5.
SOCKABUS_MODEL=
# OpenAI key. Not read by the app yet (no openai provider).
CHATGPT_API_KEY=

# ─── Telegram (https://my.telegram.org → API development tools) ───
SOCKABUS_TG_APP_ID=
SOCKABUS_TG_APP_HASH=
SOCKABUS_TG_SESSION_DIR=.secrets/telegram
# 1 = keep Telegram update state (pts/qts) in PostgreSQL so a restart replays missed messages (TRD G-9). Off by default.
SOCKABUS_TG_PERSIST_STATE=
# Development only: 1-3 uses Telegram's TEST network (fake numbers 99966XYYYY, code = X repeated).
# Leave empty for real Telegram. Test accounts cannot talk to real Telegram users.
SOCKABUS_TG_TEST_DC=
# While testing, only reply to these senders (comma-separated @usernames or tg:<user id>). Empty = everyone.
SOCKABUS_TG_ONLY_FROM=
# What the honeypot account shows under Settings → Devices. Match the persona's phone.
SOCKABUS_TG_DEVICE_MODEL=Samsung SM-A145F
SOCKABUS_TG_SYSTEM_VERSION=Android 14
# Uptime Kuma push monitor URL (Push type, 60 s heartbeat). Empty = no heartbeat.
SOCKABUS_KUMA_TG_PUSH_URL=
# Kill switch for every Telegram persona: 0 = no bot replies, read receipts or "typing…" (inbound messages are
# still stored and extracted; operator messages still send). Empty/1 = on. Needs a restart (make all).
SOCKABUS_TG_REPLIES=1

# Local chat simulator (make sim): on by default when SOCKABUS_ENV=local; set 0 to turn off, 1 to force on.
SOCKABUS_SIM=

# ─── Human-like timing (FR-3: replies never come sooner than 10 s, whatever is set here) ───
# FR-3 floor: no reply sooner than this after the scammer's last message. Lower it only in CI/tests; refused when SOCKABUS_ENV=prod.
SOCKABUS_REPLY_DELAY_MIN=10s
SOCKABUS_REPLY_READ_MIN=12s
SOCKABUS_REPLY_READ_MAX=45s
# Think + type speed in words per minute (30 ≈ Malaysian average incl. thinking).
SOCKABUS_TYPING_WPM=30
# Pause before each extra bubble when one reply is split into several messages.
SOCKABUS_REPLY_BUBBLE_GAP=10s
SOCKABUS_INACTIVITY=72h
# Per-persona human-like timing (personas.profile "timing": wpm, sleep window, busyness, typo_rate):
# notice/read/think/type delays, sleep hours, "brb" gaps and typos. Empty = on unless
# SOCKABUS_REPLY_DELAY_MIN is below 10s (CI/tests), where READ_MIN/MAX, TYPING_WPM and BUBBLE_GAP apply instead.
SOCKABUS_HUMAN_TIMING=
# Reply mode, overrides SOCKABUS_HUMAN_TIMING: 1 = simulate a real person (real testing),
# 2 = quick replies (testing; still at least SOCKABUS_REPLY_DELAY_MIN). Empty = follow SOCKABUS_HUMAN_TIMING.
BOT_STATUS=1
# Per-persona timing overrides on top of personas.profile "timing" (no DB write, no make seed needed).
# "<persona id | name | *>:key=value,..." separated by ";". Keys: wpm (typing speed), sleep (start-end hours MYT,
# or off), busyness 0-1 (how slow to notice in a cold chat), typo 0-1 (typo chance per bubble),
# distracted 0-1 (chance of a +~15 min "pulled away" before noticing; default 0.22). Id/name beats "*".
# Applies to chats opened after a restart; an open chat keeps the timing it started with.
SOCKABUS_PERSONA_TIMING=Auntie Mei:wpm=23,sleep=22-6,busyness=0.2,typo=0.12,distracted=0.25;Ah Seng:wpm=35,sleep=2-9,busyness=0.15,typo=0.04,distracted=0.12;Kak Ros:wpm=28,sleep=23-5,busyness=0.6,typo=0.06,distracted=0.35;Uncle Wong:wpm=22,sleep=22-5,busyness=0.25,typo=0.1,distracted=0.25

# ─── Production (VPS only, used by docker-compose.prod.yml and make backup) ───
# Domain Caddy serves and gets the HTTPS certificate for. Its DNS A record must point at the VPS.
SOCKABUS_DOMAIN=
# rclone destination for nightly dumps, e.g. r2:buru-backups. Empty = dumps stay on the server.
BACKUP_REMOTE=
# Uptime Kuma push monitor URL hit after each successful backup. Empty = no push.
SOCKABUS_KUMA_BACKUP_PUSH_URL=

# ─── Demo mode only ───
SOCKABUS_SIMULATE=1
# App database login (buru_api, member of buru_app: no UPDATE/DELETE on audit tables; create it with make app-role).
# Supabase SESSION-mode pooler, port 5432 (supports pgx prepared statements; the 6543 transaction pooler does not).
# Never the direct db.<ref>.supabase.co host: it is IPv6-only and unreachable from macOS / Docker Desktop.
# pool_max_conns caps pgx's pool (default max(4, CPUs)); each session-mode client holds one pooler slot.
SOCKABUS_POSTGRES_URL="postgresql://buru_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&pool_max_conns=5"
# Tests never use this: make test-db / test-e2e use the Playwright scratch DB (make e2e-up, localhost:15432/sockabus_e2e).

# Supabase owner login (postgres.<ref>), used only for migrations (make migrate-up, make deploy), db-check and backups.
# Never give this to the app. Must be the session pooler form too (the Makefile refuses db.<ref>.supabase.co).
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL=
# Supabase session-mode pooler (used for migrations).
DIRECT_URL=
SUPABASE_PASSWORD=

# Supabase project (dashboard reference only; the web app talks to the Go API, not Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Console (web/): the /api proxy and /api/demo/lookup add the operator token server-side; it never reaches the browser.
# SOCKABUS_API_URL=http://localhost:8080
# Lookup key for the bank simulator; falls back to SOCKABUS_OPERATOR_TOKEN until per-customer keys exist (FR-13).
# SOCKABUS_LOOKUP_TOKEN=
# Console sign-in (/sign-in): Google only (OIDC code flow + PKCE on the Next server), which then sets an
# httpOnly session cookie. Every page and /api/* route needs it. Password sign-in is turned off.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application). Authorized
# redirect URIs must list, exactly:
#   http://localhost:3000/api/auth/google/callback
#   https://<SOCKABUS_DOMAIN>/api/auth/google/callback   (production, behind Caddy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the redirect URI instead of deriving it from the request host (must match the console exactly).
# GOOGLE_REDIRECT_URI=https://console.example.my/api/auth/google/callback
# Signs the session cookie (HMAC-SHA256). At least 32 characters: openssl rand -base64 48
# Changing it signs everyone out.
SOCKABUS_SESSION_SECRET=
# Who may sign in. Comma lists, case-insensitive. With both empty, nobody can sign in.
# Removing an email ends that operator's session on their next request.
# The Go backend also enforces a fixed list (internal/server/consoleauth.go); an email must be on both.
# Matching value: jaxz8835@gmail.com,jaycigan@gmail.com,ganwx88@gmail.com,andywong562006@gmail.com,horjianjia33@gmail.com
SOCKABUS_CONSOLE_GOOGLE_ALLOWED_EMAILS=
# Whole email domains, e.g. sockabus.my (matches the part after @ of a Google-verified email).
SOCKABUS_CONSOLE_GOOGLE_ALLOWED_DOMAIN=
# Development only: off = no sign-in gate. Never set this on a server reachable from the internet.
# SOCKABUS_CONSOLE_AUTH=off
# Console: true = sample data in the browser, no Go API needed (offline demo / UI work).
# NEXT_PUBLIC_USE_SAMPLE_DATA=false
# Console: how long Verify/Reject waits before saving, so Undo can cancel it (frontend spec §4.5). Use 0 in tests.
# NEXT_PUBLIC_UNDO_MS=6000

# Added in later milestones
# ANTHROPIC_API_KEY=
# TRONGRID_API_KEY=
# ETHERSCAN_API_KEY=
